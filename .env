# Puerto local de la API
PORT=8090

# Orígenes permitidos para CORS (separados por coma, sin barra final).
# Incluí la URL de tu frontend en Firebase Hosting y el dev local de Vite.
CORS_ORIGINS=https://oloos-bd.web.app,https://oloos-bd.firebaseapp.com,https://appolodesk.web.app,https://appolodesk.firebaseapp.com,http://localhost:5173

# Service account key de Firebase (ruta al JSON).
# Por defecto busca ./service-account.json si no se setea.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

